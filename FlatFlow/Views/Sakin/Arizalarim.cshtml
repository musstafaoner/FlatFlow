@model IEnumerable<FlatFlow.Models.ArizaTalep>
@{
    ViewData["Title"] = "Arıza Kayıtlarım";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-primary">Arıza ve Talep Bildirimlerim</h2>
    <a href="/Sakin/ArizaBildir" class="btn btn-danger fw-bold">+ Yeni Arıza Bildir</a>
</div>

<div class="card shadow-sm p-3">
    <table class="table table-hover table-bordered mt-2">
        <thead class="table-light">
            <tr>
                <th>Tarih</th>
                <th>Başlık</th>
                <th>Açıklama</th>
                <th>Durum</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-4">Henüz bir arıza kaydı oluşturmadınız.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="fw-bold">@item.Baslik</td>
                        <td>@item.Aciklama</td>
                        <td>
                            @if (item.Durum == "Beklemede") { <span class="badge bg-warning text-dark">Beklemede</span> }
                            else if (item.Durum == "Çözülüyor") { <span class="badge bg-primary">Çözülüyor</span> }
                            else { <span class="badge bg-success">Çözüldü</span> }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
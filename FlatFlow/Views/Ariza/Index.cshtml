@model IEnumerable<FlatFlow.Models.ArizaTalep>
@{
    ViewData["Title"] = "Arıza ve Talep Yönetimi";
    var daireler = ViewBag.Daireler as Dictionary<int, FlatFlow.Models.Daire>;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="fw-bold mb-0" style="color: #ffffff !important;">Gelen Arıza ve Talep <span style="color: #38bdf8 !important;">Bildirimleri</span></h2>
</div>

<div class="p-0" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); overflow: hidden;">
    <div class="table-responsive">
        <table class="table table-borderless mb-0">
            <thead style="border-bottom: 1px solid #334155; background-color: rgba(15, 23, 42, 0.5);">
                <tr>
                    <th style="color: #cbd5e1; padding: 16px; width: 15%;">TARİH</th>
                    <th style="color: #cbd5e1; padding: 16px; width: 25%;">BİLDİREN (DAİRE & KİŞİ)</th>
                    <th style="color: #cbd5e1; padding: 16px; width: 30%;">BAŞLIK / AÇIKLAMA</th>
                    <th style="color: #cbd5e1; padding: 16px; width: 10%;">DURUM</th>
                    <th class="text-end pe-4" style="color: #cbd5e1; padding: 16px; width: 20%;">DURUM GÜNCELLE</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5" style="color: #64748b;">
                            <i class="fa-solid fa-check-circle fs-2 mb-3 d-block" style="color: #10b981;"></i>
                            Şu an bu site için beklemede olan hiçbir arıza veya talep yok. Harika!
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var kullaniciDairesi = daireler != null && daireler.ContainsKey(item.KullaniciId) ? daireler[item.KullaniciId] : null;

                        <tr style="border-bottom: 1px solid #334155; background-color: transparent;">
                            <td style="color: #94a3b8; vertical-align: middle; padding: 16px;">@item.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>

                            <td style="vertical-align: middle; padding: 16px;">
                                @if (kullaniciDairesi != null)
                                {
                                    <span class="fw-bold text-light d-block mb-1">
                                        <i class="fa-solid fa-house-user me-1" style="color: #38bdf8;"></i> @kullaniciDairesi.Blok Blok / No: @kullaniciDairesi.KapiNumarasi
                                    </span>
                                }
                                <span style="font-size: 0.85rem; color: #94a3b8;">
                                    <i class="fa-regular fa-envelope me-1"></i> @(item.Kullanici?.Eposta ?? "Bilinmeyen Kullanıcı")
                                </span>
                            </td>

                            <td style="vertical-align: middle; padding: 16px;">
                                <span class="fw-bold text-light d-block mb-1">@item.Baslik</span>
                                <span style="font-size: 0.9rem; color: #94a3b8;">@item.Aciklama</span>
                            </td>

                            <td style="vertical-align: middle; padding: 16px;">
                                @if (item.Durum == "Beklemede")
                                {
                                    <span class="badge" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid #f59e0b; padding: 6px 12px; border-radius: 6px;">Beklemede</span>
                                }
                                else if (item.Durum == "Çözülüyor")
                                {

                                    <span class="badge" style="background-color: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid #38bdf8; padding: 6px 12px; border-radius: 6px;">Çözülüyor</span>
                                }
                                else
                                {

                                    <span class="badge" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid #10b981; padding: 6px 12px; border-radius: 6px;">Çözüldü</span>
                                }
                            </td>

                            <td class="text-end pe-4" style="vertical-align: middle; padding: 16px;">
                                <form asp-controller="Ariza" asp-action="DurumGuncelle" method="post" class="d-flex align-items-center justify-content-end m-0">
                                    <input type="hidden" name="id" value="@item.ArizaTalepId" />
                                    <select name="yeniDurum" class="form-select form-select-sm me-2" style="background-color: #0f172a !important; border: 1px solid #334155 !important; color: #ffffff !important; border-radius: 8px; width: auto;">
                                        @if (item.Durum == "Beklemede")
                                        {
                                            <option value="Beklemede" selected>Beklemede</option>
                                            <option value="Çözülüyor">Çözülüyor</option>
                                            <option value="Çözüldü">Çözüldü</option>
         }
                                        else if (item.Durum == "Çözülüyor")
                                        {
                                            <option value="Beklemede">Beklemede</option>
                                            <option value="Çözülüyor" selected>Çözülüyor</option>
                                            <option value="Çözüldü">Çözüldü</option>
         }
                                        else
                                        {
                                            <option value="Beklemede">Beklemede</option>
                                            <option value="Çözülüyor">Çözülüyor</option>
                                            <option value="Çözüldü" selected>Çözüldü</option>
         }
                                    </select>
                                    <button type="submit" class="btn btn-sm fw-bold" style="background-color: #38bdf8; color: #000; border-radius: 8px;">
                                        Kaydet
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
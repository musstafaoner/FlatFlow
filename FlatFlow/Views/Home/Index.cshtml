@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FlatFlow - Yeni Nesil Site Yönetimi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b1120;
            --card-bg: rgba(30, 41, 59, 0.5);
            --primary-glow: #38bdf8;
            --secondary-glow: #818cf8;
            --text-main: #ffffff; /* Ana yazılar tam beyaz */
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(56, 189, 248, 0.08), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(129, 140, 248, 0.08), transparent 25%);
        }

        /* BOOTSTRAP RENKLERİNİ EZİYORUZ - OKUNABİLİRLİK İÇİN */
        .text-muted {
            color: #cbd5e1 !important; /* Soluk yazıları açık gümüş rengine çevirdik */
            font-weight: 400;
        }
        
        p {
            color: #cbd5e1 !important;
            font-size: 1.1rem;
            line-height: 1.7;
        }

        /* Navbar */
        .navbar {
            background: rgba(11, 17, 32, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .brand-text {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--text-main);
            letter-spacing: -0.5px;
        }
        .brand-text span {
            color: var(--primary-glow);
        }

        /* Butonlar */
        .btn-glow {
            background: linear-gradient(135deg, var(--primary-glow), var(--secondary-glow));
            color: white !important;
            border: none;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
            transition: all 0.3s ease;
        }
        .btn-glow:hover {
            box-shadow: 0 0 30px rgba(56, 189, 248, 0.5);
            transform: translateY(-2px);
        }

        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-main) !important;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 8px;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }
        .btn-glass:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
        }

        /* Hero Section */
        .hero-section {
            padding: 140px 0 100px 0;
            min-height: 80vh;
            display: flex;
            align-items: center;
        }

        .badge-glow {
            background: rgba(56, 189, 248, 0.1);
            border: 1px solid rgba(56, 189, 248, 0.2);
            color: var(--primary-glow);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 24px;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 24px;
            color: #ffffff;
        }
        
        .gradient-text {
            background: linear-gradient(to right, var(--primary-glow), var(--secondary-glow));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-image {
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            width: 100%;
        }

        /* Feature Cards (Cam Efekti) */
        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 32px;
            height: 100%;
            transition: transform 0.3s ease, border-color 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .glass-card:hover {
            transform: translateY(-5px);
            border-color: rgba(56, 189, 248, 0.3);
        }
        
        .glass-card h4 {
            color: #ffffff !important;
        }

        .card-icon {
            font-size: 24px;
            color: var(--primary-glow);
            margin-bottom: 20px;
            background: rgba(56, 189, 248, 0.1);
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
        }

        /* Mini Widgetlar */
        .mini-widget {
            margin-top: auto;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .widget-box {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 8px;
            padding: 12px;
            font-size: 0.85rem;
            color: #cbd5e1;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top py-3">
        <div class="container">
            <a class="navbar-brand brand-text" href="#">Flat<span>Flow</span></a>
            <div class="d-flex gap-3">
                <a href="/Hesap/GirisYap" class="btn btn-glass text-decoration-none">Giriş Yap</a>
                <a href="/Hesap/KayitOl" class="btn btn-glow text-decoration-none">Hesap Oluştur</a>
            </div>
        </div>
    </nav>

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="badge-glow">FlatFlow v1.0 Yayında</div>
                    <h1 class="hero-title">
                        Apartman ve Site Yönetimini <br>
                        <span class="gradient-text">Dijitale Taşıyın.</span>
                    </h1>
                    <p class="mb-5" style="max-width: 90%;">
                        Aidat takiplerini otomatikleştirin, arıza bildirimlerini tek merkezden yönetin ve apartman sakinleriyle kesintisiz iletişim kurun. Hem yöneticiler hem de sakinler için tasarlandı.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="/Hesap/KayitOl" class="btn btn-glow btn-lg px-4">Sistemi Ücretsiz Dene</a>
                        <a href="#ozellikler" class="btn btn-glass btn-lg px-4">Özellikleri Keşfet</a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2070&auto=format&fit=crop" alt="Dashboard" class="hero-image">
                </div>
            </div>
        </div>
    </section>

    <section id="ozellikler" class="py-5 mb-5">
        <div class="container">
            <div class="text-center mb-5 pb-3">
                <h2 class="fw-bold fs-1 text-white">Neden FlatFlow?</h2>
                <p>Geleneksel apartman yöneticiliğini geride bırakan modern çözümler.</p>
            </div>
            
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="glass-card">
                        <div class="card-icon">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Şeffaf Aidat Takibi</h4>
                        <p class="mb-4">Yöneticiler tek tıkla borçlandırır, bina sakinleri ödemelerini ve geçmiş borçlarını anlık olarak şeffafça görüntüler.</p>
                        
                        <div class="mini-widget">
                            <h6 class="mb-2 fs-6" style="color: #94a3b8;">Aylık Gelir Takibi</h6>
                            <div class="widget-box d-flex align-items-end" style="height: 60px; background: linear-gradient(to top, rgba(56,189,248,0.1), transparent);">
                                <svg width="100%" height="40" viewBox="0 0 200 40" preserveAspectRatio="none">
                                    <path d="M0,30 Q25,10 50,25 T100,20 T150,30 T200,15" fill="none" stroke="#38bdf8" stroke-width="2"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="glass-card">
                        <div class="card-icon">
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Arıza ve Bilet Sistemi</h4>
                        <p class="mb-4">Ortak alanlardaki problemleri WhatsApp gruplarında kaybetmeyin. Arızaları sisteme girin ve durumunu anlık takip edin.</p>
                        
                        <div class="mini-widget">
                            <h6 class="mb-2 fs-6" style="color: #94a3b8;">Ticket Durumu</h6>
                            <div class="widget-box d-flex justify-content-between align-items-center mb-2">
                                <span>Asansör Bakımı</span>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Çözüldü</span>
                            </div>
                            <div class="widget-box d-flex justify-content-between align-items-center">
                                <span>Koridor Lambası</span>
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25">Beklemede</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="glass-card">
                        <div class="card-icon">
                            <i class="fa-solid fa-bullhorn"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Anlık Dijital Pano</h4>
                        <p class="mb-4">Asansör kapısına kağıt asma devri bitti. Yönetimin aldığı kararlar ve duyurular doğrudan sakinlerin dijital panosuna düşer.</p>
                        
                        <div class="mini-widget">
                            <h6 class="mb-2 fs-6" style="color: #94a3b8;">Son Bildirimler</h6>
                            <div class="widget-box d-flex gap-2">
                                <i class="fa-solid fa-circle-info text-primary mt-1"></i>
                                <div>
                                    <strong class="d-block text-white">Su Kesintisi Hakkında</strong>
                                    <span style="color: #94a3b8; font-size: 11px;">10 dakika önce</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="py-4 text-center border-top" style="border-color: rgba(255,255,255,0.05) !important;">
        <div class="container">
            <p class="mb-0" style="color: #94a3b8; font-size: 0.9rem;">&copy; 2026 FlatFlow Dijital Site Yönetimi. Tüm hakları saklıdır.</p>
        </div>
    </footer>

</body>
</html>
@model IEnumerable<FlatFlow.Models.Duyuru>
@{
    ViewData["Title"] = "Dashboard";
    bool yoneticiMi = User.IsInRole("Yonetici");
}

<div class="mt-4 mb-5">
    <h2 class="fw-bold" style="color: #ffffff !important;">
        <span style="color: #38bdf8 !important;">@ViewBag.AktifSiteAdi</span> @(yoneticiMi ? "Yönetim Paneli" : "Sakin Paneli")
    </h2>
    <p style="color: #cbd5e1 !important; font-size: 1.1rem;">
        Hoş Geldiniz, @User.Identity.Name.
        @(yoneticiMi ? "Apartman ve sitenizin genel durumunu tek bakışta inceleyin." : "Güncel borçlarınızı ve site duyurularını buradan takip edebilirsiniz.")
    </p>
</div>

@if (yoneticiMi)
{
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="p-4 h-100" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; border-bottom: 4px solid #38bdf8 !important; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-uppercase fw-bold mb-0" style="color: #cbd5e1 !important; font-size: 0.85rem;">Toplam Daire</h6>
                    <i class="fa-solid fa-building" style="color: #38bdf8; font-size: 1.5rem;"></i>
                </div>
                <h2 class="fw-bold mb-0" style="color: #ffffff !important;">@ViewBag.ToplamDaire</h2>
                <div class="progress mt-3" style="height: 8px; background-color: #0f172a !important;">
                    <div class="progress-bar" role="progressbar" style="width: 100%; background-color: #38bdf8 !important;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 h-100" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; border-bottom: 4px solid #10b981 !important; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-uppercase fw-bold mb-0" style="color: #cbd5e1 !important; font-size: 0.85rem;">Dolu Daire</h6>
                    <i class="fa-solid fa-user-check" style="color: #10b981; font-size: 1.5rem;"></i>
                </div>
                <h2 class="fw-bold mb-0" style="color: #ffffff !important;">@ViewBag.DoluDaire</h2>
                @if (ViewBag.ToplamDaire != null && ViewBag.ToplamDaire > 0)
                {
                    var dolulukOrani = (int)((double)ViewBag.DoluDaire / ViewBag.ToplamDaire * 100);
                    <div class="progress mt-3" style="height: 8px; background-color: #0f172a !important;">
                        <div class="progress-bar" role="progressbar" style="width: @dolulukOrani%; background-color: #10b981 !important;" aria-valuenow="@dolulukOrani" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="mt-2 d-block" style="color: #94a3b8 !important; font-weight: 600;">Doluluk Oranı: %@dolulukOrani</small>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 h-100" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; border-bottom: 4px solid #f59e0b !important; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-uppercase fw-bold mb-0" style="color: #cbd5e1 !important; font-size: 0.85rem;">Bekleyen Arıza</h6>
                    <i class="fa-solid fa-screwdriver-wrench" style="color: #f59e0b; font-size: 1.5rem;"></i>
                </div>
                <h2 class="fw-bold mb-0" style="color: #ffffff !important;">@ViewBag.BekleyenAriza</h2>
                <div class="progress mt-3" style="height: 8px; background-color: #0f172a !important;">
                    <div class="progress-bar" role="progressbar" style="width: 100%; background-color: #f59e0b !important;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 h-100" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; border-bottom: 4px solid #ef4444 !important; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="text-uppercase fw-bold mb-0" style="color: #cbd5e1 !important; font-size: 0.85rem;">Kasadaki Tutar</h6>
                    <i class="fa-solid fa-file-invoice-dollar" style="color: #ef4444; font-size: 1.5rem;"></i>
                </div>
                <h2 class="fw-bold mb-0" style="color: #ffffff !important;">@ViewBag.Kasa ₺</h2>
                <div class="progress mt-3" style="height: 8px; background-color: #0f172a !important;">
                    <div class="progress-bar" role="progressbar" style="width: 100%; background-color: #ef4444 !important;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="p-4 mb-5" style="background-color: rgba(16, 185, 129, 0.1) !important; border: 1px solid rgba(16, 185, 129, 0.3) !important; border-radius: 16px;">
        <h4 class="fw-bold mb-3" style="color: #10b981 !important;"><i class="fa-solid fa-house-user me-2"></i> Dairenize Hoş Geldiniz!</h4>
        <p class="fs-6" style="color: #cbd5e1 !important;">FlatFlow paneli üzerinden <strong>güncel borçlarınızı</strong> takip edebilir, site yönetimi tarafından yayınlanan <strong>duyuruları</strong> okuyabilir ve teknik problemler için <strong>arıza bildirimi</strong> oluşturabilirsiniz.</p>
        <hr style="border-color: #334155;">
        <p class="mb-0" style="color: #94a3b8 !important;"><i class="fa-solid fa-circle-info me-2"></i> Lütfen aidat ödemelerinizi ay sonuna kadar gerçekleştirmeyi unutmayın.</p>
    </div>
}

<div class="row g-4">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0" style="color: #ffffff !important;">Son <span style="color: #38bdf8 !important;">Duyurular</span></h4>
            @if (yoneticiMi)
            {
                <a href="/Duyuru/Ekle" class="btn btn-sm btn-outline-info" style="border-radius: 8px; font-weight: 600;"><i class="fa-solid fa-plus me-1"></i> Yeni Duyuru Ekle</a>
            }
        </div>

        <div class="p-4 h-100" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-4" style="color: #64748b;">
                    <i class="fa-solid fa-bell-slash fs-1 mb-3"></i>
                    <p class="mb-0">Sistemde henüz yayınlanmış bir duyuru bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var duyuru in Model)
                    {
                        <div class="list-group-item py-4 px-0 border-bottom" style="background-color: transparent !important; border-color: #334155 !important;">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold mb-0" style="color: #38bdf8 !important;">@duyuru.Baslik</h6>
                                <span class="badge" style="background-color: #0f172a !important; border: 1px solid #334155 !important; color: #94a3b8 !important; padding: 6px 10px;">@duyuru.OlusturulmaTarihi.ToString("dd MMM yyyy - HH:mm")</span>
                            </div>
                            <p class="mb-0 mt-3 fs-6" style="color: #cbd5e1 !important; line-height: 1.6;">@duyuru.Icerik</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-md-4">
        <h4 class="fw-bold mb-3" style="color: #ffffff !important;">Hızlı <span style="color: #38bdf8 !important;">İşlemler</span></h4>
        <div class="p-4 h-100" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
            <div class="d-grid gap-3">
                @if (yoneticiMi)
                {
                    <div class="list-group list-group-flush border-0">
                        <a asp-controller="Daire" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center mb-2" style="background-color: #0f172a !important; border: 1px solid #334155 !important; border-radius: 10px; color: #ffffff !important; padding: 12px 16px; transition: 0.3s;">
                            <i class="fa-solid fa-building me-3" style="color: #38bdf8; font-size: 1.2rem;"></i> Daireleri Yönet
                        </a>
                        <a asp-controller="Aidat" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center mb-2" style="background-color: #0f172a !important; border: 1px solid #334155 !important; border-radius: 10px; color: #ffffff !important; padding: 12px 16px; transition: 0.3s;">
                            <i class="fa-solid fa-file-invoice-dollar me-3" style="color: #ef4444; font-size: 1.2rem;"></i> Aidat Yansıt
                        </a>
                        <a asp-controller="Ariza" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center mb-2" style="background-color: #0f172a !important; border: 1px solid #334155 !important; border-radius: 10px; color: #ffffff !important; padding: 12px 16px; transition: 0.3s;">
                            <i class="fa-solid fa-screwdriver-wrench me-3" style="color: #f59e0b; font-size: 1.2rem;"></i> Arızaları İncele
                        </a>
                        <a asp-controller="Duyuru" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center" style="background-color: #0f172a !important; border: 1px solid #334155 !important; border-radius: 10px; color: #ffffff !important; padding: 12px 16px; transition: 0.3s;">
                            <i class="fa-solid fa-bullhorn me-3" style="color: #10b981; font-size: 1.2rem;"></i> Duyuruları Yönet
                        </a>
                    </div>
                }
                else
                {
                    <a href="/Sakin/Borclarim" class="btn text-start py-3 fw-bold border-0 rounded-3 shadow-none h-100 d-flex align-items-center" style="background-color: #0f172a !important; border: 1px solid #334155 !important; color: #ffffff !important;">
                        <i class="fa-solid fa-credit-card fs-5 text-success me-3"></i> Borç Öde
                    </a>
                    <a href="/Sakin/Arizalarim" class="btn text-start py-3 fw-bold border-0 rounded-3 shadow-none h-100 d-flex align-items-center" style="background-color: #0f172a !important; border: 1px solid #334155 !important; color: #ffffff !important;">
                        <i class="fa-solid fa-wrench fs-5 text-warning me-3"></i> Yeni Arıza Bildir
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/your-fontawesome-kit-code.js" crossorigin="anonymous"></script>
}
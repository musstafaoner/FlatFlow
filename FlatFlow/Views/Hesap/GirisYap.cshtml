@model FlatFlow.Models.GirisViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap | FlatFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', system-ui, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            padding: 40px;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .brand {
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            text-align: center;
            margin-bottom: 2rem;
        }

            .brand span {
                color: #38bdf8;
            }

        .form-control {
            background-color: #0f172a !important;
            border: 1px solid #475569 !important;
            color: #ffffff !important;
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
            .form-control::-webkit-input-placeholder {
                color: #cbd5e1 !important;
                opacity: 1 !important;
            }

            .form-control::-moz-placeholder {
                color: #cbd5e1 !important;
                opacity: 1 !important;
            }

            .form-control:-ms-input-placeholder {
                color: #cbd5e1 !important;
                opacity: 1 !important;
            }

            .form-control::placeholder {
                color: #cbd5e1 !important;
                opacity: 1 !important;
            }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: #38bdf8;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            color: #000;
            transition: 0.3s;
        }

            .btn-submit:hover {
                background: #7dd3fc;
            }

        .footer-link {
            text-align: center;
            margin-top: 20px;
            font-size: 0.9rem;
            color: #94a3b8;
        }

            .footer-link a {
                color: #38bdf8;
                text-decoration: none;
                font-weight: 600;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">Flat<span>Flow</span></div>
        <form asp-action="GirisYap" method="post">
            <label style="color: #cbd5e1 !important; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block;">E-posta Adresi</label>
            <input type="email" asp-for="Eposta" class="form-control" placeholder="ornek@mail.com" required />

            <label style="color: #cbd5e1 !important; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block;">Şifre</label>
            <input type="password" asp-for="Sifre" class="form-control" placeholder="••••••••" required />

            <button type="submit" class="btn-submit">Sisteme Giriş Yap</button>
        </form>
        <div class="footer-link">Hesabınız yok mu? <a href="/Hesap/KayitOl" style="color: #38bdf8 !important;">Kayıt Olun</a></div>
    </div>
</body>
</html>
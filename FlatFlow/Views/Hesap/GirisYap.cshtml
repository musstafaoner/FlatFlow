@model FlatFlow.Models.GirisViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş - FlatFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            font-family: 'Inter', system-ui, sans-serif;
            margin: 0;
        }

        .login-container {
            width: 100%;
            max-width: 400px;
            padding: 40px;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .brand {
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 2rem;
            text-align: center;
            letter-spacing: -1px;
        }

        .brand span { color: #38bdf8; }

        .form-label {
            color: #cbd5e1; /* Daha okunabilir gümüş */
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            background-color: #0f172a !important;
            border: 1px solid #475569 !important;
            color: #ffffff !important;
            padding: 14px 16px;
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
            outline: none;
        }

        .form-control::placeholder {
            color: #64748b !important;
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: #38bdf8;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            color: #000;
            margin-top: 1.5rem;
            transition: all 0.3s ease;
        }
        /* Placeholder rengini beyazımsı, belirgin bir gri yapıyoruz */
.form-control::placeholder {
    color: #94a3b8 !important; /* Daha açık ve canlı bir gri */
    opacity: 1 !important;      /* Opaklığı tam yaparak soluk görünmesini engelliyoruz */
}

/* Label'ları formun üstünde daha net göster */
.form-label {
    color: #cbd5e1 !important; /* Etiketleri biraz daha parlak yapıyoruz */
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
}

/* Input kutusunun kendi içine yazılan metnin rengi */
.form-control {
    color: #ffffff !important; /* Kullanıcı yazmaya başladığında beyaz görünsün */
}

        .btn-submit:hover {
            background: #7dd3fc;
            transform: translateY(-2px);
            box-shadow: 0 10px 15px rgba(56, 189, 248, 0.2);
        }

        .footer-link {
            text-align: center;
            margin-top: 1.5rem;
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .footer-link a {
            color: #38bdf8;
            text-decoration: none;
            font-weight: 600;
        }

        .error-alert {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #fca5a5; /* Daha yumuşak kırmızı */
            padding: 12px;
            border-radius: 10px;
            font-size: 0.85rem;
            text-align: center;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="brand">Flat<span>Flow</span></div>

        @if (ViewBag.Hata != null)
        {
            <div class="error-alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i> @ViewBag.Hata
            </div>
        }

        <form asp-action="GirisYap" method="post">
            <div class="mb-3">
                <label class="form-label">E-posta Adresi</label>
                <input type="email" asp-for="Eposta" class="form-control" placeholder="ornek@mail.com" required />
            </div>

            <div class="mb-4">
                <label class="form-label">Şifre</label>
                <input type="password" asp-for="Sifre" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-submit">Sisteme Giriş Yap</button>
        </form>

        <div class="footer-link">
            Hesabınız yok mu? <a href="/Hesap/KayitOl">Ücretsiz Kayıt Ol</a>
        </div>
    </div>

</body>
</html>
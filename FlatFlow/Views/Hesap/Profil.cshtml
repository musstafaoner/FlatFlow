@model FlatFlow.Models.Kullanici
@{
    ViewData["Title"] = "Profilimi Düzenle";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="d-flex align-items-center mb-4">
            <a href="/Home/Index" class="btn btn-sm me-3" style="background-color: #334155; color: #f8fafc; border-radius: 8px;">
                <i class="fa-solid fa-arrow-left"></i> Vazgeç
            </a>
            <h3 class="fw-bold mb-0" style="color: #ffffff !important;">Profil <span style="color: #38bdf8 !important;">Ayarlarım</span></h3>
        </div>

        <div class="p-4" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">

            <div class="text-center mb-4 pb-4" style="border-bottom: 1px solid #334155;">
                <div class="d-inline-flex align-items-center justify-content-center mb-2" style="width: 80px; height: 80px; background-color: rgba(56, 189, 248, 0.1); border: 2px solid #38bdf8; border-radius: 50%;">
                    <i class="fa-solid fa-user-astronaut fs-1" style="color: #38bdf8;"></i>
                </div>
                <h5 class="fw-bold text-light mt-2 mb-0">@Model.Ad @Model.Soyad</h5>
                <span style="color: #94a3b8;">Sistem Kayıtlı Bilgileriniz</span>
            </div>

            <form asp-action="Profil" method="post">
                <input type="hidden" asp-for="KullaniciId" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="fw-bold mb-2" style="color: #cbd5e1 !important; font-size: 0.9rem;">Ad</label>
                        <input type="text" asp-for="Ad" class="form-control" required
                               style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; padding: 12px 16px; border-radius: 10px;" />
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold mb-2" style="color: #cbd5e1 !important; font-size: 0.9rem;">Soyad</label>
                        <input type="text" asp-for="Soyad" class="form-control" required
                               style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; padding: 12px 16px; border-radius: 10px;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="fw-bold mb-2" style="color: #cbd5e1 !important; font-size: 0.9rem;">E-Posta Adresi</label>
                    <input type="email" asp-for="Eposta" class="form-control" required
                           style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; padding: 12px 16px; border-radius: 10px;" />
                </div>

                <div class="mb-4">
                    <label class="fw-bold mb-2" style="color: #cbd5e1 !important; font-size: 0.9rem;">Telefon Numarası</label>
                    <input type="text" asp-for="TelefonNumarasi" class="form-control" required
                           style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; padding: 12px 16px; border-radius: 10px;" />
                </div>

                <div class="p-3 mb-4" style="background-color: rgba(245, 158, 11, 0.05); border: 1px dashed #f59e0b; border-radius: 10px;">
                    <label class="fw-bold mb-2" style="color: #f59e0b !important; font-size: 0.9rem;">
                        <i class="fa-solid fa-lock me-1"></i> Şifre Değiştir (İsteğe Bağlı)
                    </label>
                    <input type="password" name="YeniSifre" class="form-control" placeholder="Mevcut şifrenizi korumak için burayı boş bırakın..."
                           style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; padding: 12px 16px; border-radius: 10px;" />
                </div>

                <button type="submit" class="btn w-100 fw-bold" style="background-color: #38bdf8; color: #000; padding: 14px; border-radius: 10px; transition: 0.3s;">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Profilimi Güncelle
                </button>
            </form>
        </div>
    </div>
</div>
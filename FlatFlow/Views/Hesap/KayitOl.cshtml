@model FlatFlow.Models.KayitViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol | FlatFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.min.css"/>
    <style>
.form-control::placeholder {
    color: #94a3b8 !important; 
    opacity: 1 !important;     

.form-label {
    color: #cbd5e1 !important; 
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 8px;
    display: block;
}

.form-control {
    color: #ffffff !important;
}
        body { background: #0f172a; display: flex; align-items: center; justify-content: center; min-height: 100vh; font-family: sans-serif; }
        .card { width: 100%; max-width: 450px; padding: 40px; background: #1e293b; border-radius: 20px; border: 1px solid #334155; }
        .brand { font-size: 1.8rem; font-weight: 800; color: #fff; text-align: center; margin-bottom: 2rem; }
        .brand span { color: #38bdf8; }
        label { color: #94a3b8; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; display: block; }
        .form-control, .iti { background: #0f172a !important; border: 1px solid #475569 !important; border-radius: 10px !important; margin-bottom: 15px; color: #fff !important; width: 100%; }
        .iti__flag-container { background: #0f172a; border-radius: 10px 0 0 10px; }
        .btn-reg { width: 100%; padding: 14px; background: #38bdf8; border: none; border-radius: 10px; font-weight: 700; color: #000; }
        .btn-reg:hover { background: #7dd3fc; }
        .footer { text-align: center; margin-top: 20px; color: #94a3b8; font-size: 0.9rem; }
        .footer a { color: #38bdf8; text-decoration: none; }
    </style>
</head>
<body>
    <div class="card">
        <div class="brand">Flat<span>Flow</span> | Kayıt</div>
        <form asp-action="KayitOl" method="post">
            <div class="row">
                <div class="col-6"><label>Ad</label><input type="text" asp-for="Ad" class="form-control" placeholder="Ad" required /></div>
                <div class="col-6"><label>Soyad</label><input type="text" asp-for="Soyad" class="form-control" placeholder="Soyad" required /></div>
            </div>
            <label>E-posta Adresi</label>
            <input type="email" asp-for="Eposta" class="form-control" placeholder="ornek@mail.com" required />
            <label>Telefon Numarası</label>
            <input type="tel" id="phone" name="TelefonNumarasi" class="form-control" required />
            <label>Sistemdeki Rolünüz</label>
            <select asp-for="SecilenRol" class="form-control" required>
                <option value="" disabled selected>Rol Seçiniz...</option>
                <option value="Yonetici">Apartman Yöneticisi</option>
                <option value="Sakin">Bina Sakini</option>
            </select>
            <div class="row">
                <div class="col-6"><label>Şifre</label><input type="password" asp-for="Sifre" class="form-control" placeholder="••••" required /></div>
                <div class="col-6"><label>Şifre Tekrar</label><input type="password" asp-for="SifreTekrar" class="form-control" placeholder="••••" required /></div>
            </div>
            <button type="submit" class="btn-reg">Hesabımı Oluştur</button>
        </form>
        <div class="footer">Zaten hesabınız var mı? <a href="/Hesap/GirisYap">Giriş Yapın</a></div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
    <script>
        const input = document.querySelector("#phone");
        const iti = window.intlTelInput(input, { initialCountry: "tr", separateDialCode: true });
        
        input.addEventListener('input', function (e) {
            let x = e.target.value.replace(/\D/g, '').match(/(\d{0,3})(\d{0,3})(\d{0,2})(\d{0,2})/);
            e.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '') + (x[4] ? '-' + x[4] : '');
        });
    </script>
</body>
</html>
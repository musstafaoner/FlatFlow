@model FlatFlow.Models.Aidat
@{
    ViewData["Title"] = "Aidat Detayı";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-sm me-3" style="background-color: #334155; color: #f8fafc; border-radius: 8px;">
                <i class="fa-solid fa-arrow-left"></i> Listeye Dön
            </a>
            <h3 class="fw-bold mb-0" style="color: #ffffff !important;">Aidat <span style="color: #ef4444 !important;">Detayları</span></h3>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-4 h-100" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
                    <div class="d-flex align-items-center mb-4">
                        <div class="d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: rgba(56, 189, 248, 0.1); border-radius: 12px; margin-right: 15px;">
                            <i class="fa-solid fa-house-chimney-user fs-5" style="color: #38bdf8;"></i>
                        </div>
                        <h5 class="fw-bold mb-0" style="color: #ffffff !important;">Daire Bilgileri</h5>
                    </div>

                    <div class="mb-3">
                        <small style="color: #94a3b8 !important; display: block; margin-bottom: 4px;">Blok & Kapı No</small>
                        <p class="fw-bold fs-5 mb-0" style="color: #f8fafc !important;">@Model.Daire.Blok Blok / No: @Model.Daire.KapiNumarasi</p>
                    </div>

                    <hr style="border-color: #334155;">

                    <div>
                        <small style="color: #94a3b8 !important; display: block; margin-bottom: 4px;">Oturan Sakin</small>
                        @if (Model.Daire.Kullanici != null)
                        {
                            <p class="mb-0" style="color: #cbd5e1 !important;"><i class="fa-regular fa-envelope me-2"></i> @Model.Daire.Kullanici.Eposta</p>
                        }
                        else
                        {
                            <p class="mb-0" style="color: #f59e0b !important; font-style: italic;">- Daire Boş -</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 h-100 d-flex flex-column" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);">
                    <div class="d-flex align-items-center mb-4">
                        <div class="d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: rgba(239, 68, 68, 0.1); border-radius: 12px; margin-right: 15px;">
                            <i class="fa-solid fa-file-invoice-dollar fs-5" style="color: #ef4444;"></i>
                        </div>
                        <h5 class="fw-bold mb-0" style="color: #ffffff !important;">Tahsilat Durumu</h5>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <small style="color: #94a3b8 !important; display: block; margin-bottom: 4px;">Dönem Tutarı (@Model.Ay / @Model.Yil)</small>
                            <h2 class="fw-bold mb-0" style="color: #ef4444 !important;">@Model.Tutar.ToString("N2") ₺</h2>
                        </div>
                        <div>
                            @if (Model.OdendiMi)
                            {
                                <span class="badge" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid #10b981; padding: 8px 16px; font-size: 0.9rem; border-radius: 8px;">Ödendi</span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid #f59e0b; padding: 8px 16px; font-size: 0.9rem; border-radius: 8px;">Borçlu</span>
                            }
                        </div>
                    </div>

                    <div class="mt-auto pt-4 border-top" style="border-color: #334155 !important;">
                        <form asp-action="DurumDegistir" method="post">
                            <input type="hidden" name="id" value="@Model.AidatId" />
                            @if (Model.OdendiMi)
                            {
                                <button type="submit" class="btn w-100 fw-bold" style="background-color: transparent; border: 1px solid #f59e0b; color: #f59e0b; border-radius: 8px; padding: 10px;">
                                    <i class="fa-solid fa-rotate-left me-2"></i> Yanlışlık Var (Borçlu Olarak İşaretle)
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn w-100 fw-bold" style="background-color: #10b981; color: #fff; border-radius: 8px; padding: 10px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                                    <i class="fa-solid fa-hand-holding-dollar me-2"></i> Elden Tahsil Edildi (Ödendi İşaretle)
                                </button>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<FlatFlow.Models.Aidat>
@{
    ViewData["Title"] = "Aidat ve Borç Takibi";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="fw-bold mb-0" style="color: #ffffff !important;">Aidat ve Borç <span style="color: #ef4444 !important;">Takibi</span></h2>
    <a asp-action="Ekle" class="btn fw-bold" style="background-color: #ef4444; color: #fff; border-radius: 10px; padding: 10px 20px; transition: 0.3s;">
        <i class="fa-solid fa-plus me-2"></i> Yeni Aidat Yansıt
    </a>
</div>

<div class="p-3 mb-4" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
    <form method="get" asp-action="Index" class="row gx-3 align-items-end">
        <div class="col-md-3">
            <label class="fw-bold mb-2" style="color: #cbd5e1 !important; font-size: 0.9rem;">
                <i class="fa-solid fa-layer-group me-1"></i> Blok Filtresi
            </label>
            <select name="arananBlok" class="form-select" style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; border-radius: 8px;">
                <option value="">Tüm Blokları Göster</option>
                @if (ViewBag.Bloklar != null)
                {
                    foreach (var blok in ViewBag.Bloklar)
                    {
                        if (ViewBag.SeciliBlok == blok)
                        {
                            <option value="@blok" selected>@blok</option>
                        }
                        else
                        {
                            <option value="@blok">@blok</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="fw-bold mb-2" style="color: #cbd5e1 !important; font-size: 0.9rem;">
                <i class="fa-solid fa-file-invoice-dollar me-1"></i> Borç Durumu
            </label>
            <select name="odemeDurumu" class="form-select" style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; border-radius: 8px;">
                <option value="">Tümü (Ödenenler ve Borçlar)</option>
                @if (ViewBag.SeciliDurum == "Odenmedi")
                {
                    <option value="Odenmedi" selected>Sadece Borcu Olanlar (Ödenmedi)</option>
                }
                else
                {
                    <option value="Odenmedi">Sadece Borcu Olanlar (Ödenmedi)</option>
                }

                @if (ViewBag.SeciliDurum == "Odendi")
                {
                    <option value="Odendi" selected>Sadece Ödeyenler</option>
                }
                else
                {
                    <option value="Odendi">Sadece Ödeyenler</option>
                }
            </select>
        </div>

        <div class="col-md-5 d-flex gap-2">
            <button type="submit" class="btn fw-bold w-100" style="background-color: #ef4444; color: #fff; border-radius: 8px; padding: 8px 20px; transition: 0.3s;">
                <i class="fa-solid fa-filter me-1"></i> Filtrele
            </button>

            @if (!string.IsNullOrEmpty(ViewBag.SeciliBlok) || !string.IsNullOrEmpty(ViewBag.SeciliDurum))
            {
                <a asp-action="Index" class="btn fw-bold px-4" style="background-color: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid #ef4444; border-radius: 8px; padding: 8px 20px; transition: 0.3s;">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </div>
    </form>
</div>
<div class="p-0" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); overflow: hidden;">
    <div class="table-responsive">
        <table class="table table-borderless mb-0">
            <thead style="border-bottom: 1px solid #334155; background-color: rgba(15, 23, 42, 0.5);">
                <tr>
                    <th style="color: #cbd5e1; padding: 16px;">DAİRE</th>
                    <th style="color: #cbd5e1; padding: 16px;">SAKİN</th>
                    <th style="color: #cbd5e1; padding: 16px;">DÖNEM</th>
                    <th style="color: #cbd5e1; padding: 16px;">TUTAR</th>
                    <th style="color: #cbd5e1; padding: 16px;">DURUM</th>
                    <th class="text-end pe-4" style="color: #cbd5e1; padding: 16px;">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color: #64748b;">
                            <i class="fa-solid fa-file-invoice-dollar fs-2 mb-3 d-block"></i>
                            Bu kriterlere uygun bir aidat kaydı bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #334155; background-color: transparent;">
                            <td class="fw-bold text-light" style="vertical-align: middle; padding: 16px;">
                                @item.Daire.Blok Blok <span style="color: #94a3b8; font-weight: normal;">/ No: @item.Daire.KapiNumarasi</span>
                            </td>
                            <td style="color: #cbd5e1; vertical-align: middle; padding: 16px;">
                                @(item.Daire.Kullanici != null ? item.Daire.Kullanici.Eposta : "- Boş Daire -")
                            </td>
                            <td style="color: #94a3b8; vertical-align: middle; padding: 16px;">@item.Ay / @item.Yil</td>
                            <td class="fw-bold" style="color: #ef4444; vertical-align: middle; padding: 16px;">@item.Tutar.ToString("N2") ₺</td>
                            <td style="vertical-align: middle; padding: 16px;">
                                @if (item.OdendiMi)
                                {
                                    <span class="badge" style="background-color: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid #10b981; padding: 6px 12px; border-radius: 6px;">Ödendi</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid #f59e0b; padding: 6px 12px; border-radius: 6px;">Borçlu</span>
                                }
                            </td>
                            <td class="text-end pe-4" style="vertical-align: middle; padding: 16px;">
                                <a asp-action="Detay" asp-route-id="@item.AidatId" class="btn btn-sm fw-bold" style="background-color: transparent; border: 1px solid #64748b; color: #94a3b8; border-radius: 8px; padding: 6px 16px; transition: 0.3s;">
                                    Detay
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
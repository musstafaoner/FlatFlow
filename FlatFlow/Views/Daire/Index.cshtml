@model IEnumerable<FlatFlow.Models.Daire>
@{
    ViewData["Title"] = "Daire Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="fw-bold mb-0" style="color: #ffffff !important;">Daire <span style="color: #38bdf8 !important;">Listesi</span></h2>
    <a asp-action="Ekle" class="btn fw-bold" style="background-color: #10b981; color: #fff; border-radius: 10px; padding: 10px 20px; transition: 0.3s;">
        <i class="fa-solid fa-plus me-2"></i> Yeni Daire Ekle
    </a>
</div>
<div class="p-3 mb-4" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
    <form method="get" asp-action="Index" class="row gx-3 align-items-end">
        <div class="col-md-4">
            <label class="fw-bold mb-2" style="color: #cbd5e1 !important; font-size: 0.9rem;">
                <i class="fa-solid fa-layer-group me-1"></i> Blok Filtrele
            </label>
            <select name="arananBlok" class="form-select" style="background-color: #0f172a !important; border: 1px solid #475569 !important; color: #ffffff !important; border-radius: 8px;">
                <option value="">Tüm Blokları Göster</option>

                @if (ViewBag.Bloklar != null)
                {
                    foreach (var blok in ViewBag.Bloklar)
                    {
                        if (ViewBag.SeciliBlok == blok)
                        {
                            <option value="@blok" selected>@blok</option>
                        }
                        else
                        {
                            <option value="@blok">@blok</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="col-md-8 d-flex gap-2">
            <button type="submit" class="btn fw-bold" style="background-color: #38bdf8; color: #000; border-radius: 8px; padding: 8px 20px; transition: 0.3s;">
                <i class="fa-solid fa-filter me-1"></i> Sonuçları Getir
            </button>

            @if (!string.IsNullOrEmpty(ViewBag.SeciliBlok))
            {
                <a asp-action="Index" class="btn fw-bold" style="background-color: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid #ef4444; border-radius: 8px; padding: 8px 20px; transition: 0.3s;">
                    <i class="fa-solid fa-xmark me-1"></i> Temizle
                </a>
            }
        </div>
    </form>
</div>
<div class="p-0" style="background-color: #1e293b !important; border: 1px solid #334155 !important; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); overflow: hidden;">
    <div class="table-responsive">
        <table class="table table-borderless mb-0">
            <thead style="border-bottom: 1px solid #334155;">
                <tr>
                    <th style="color: #cbd5e1; padding: 16px;">BLOK</th>
                    <th style="color: #cbd5e1; padding: 16px;">KAPI NO</th>
                    <th style="color: #cbd5e1; padding: 16px;">TİPİ</th>
                    <th style="color: #cbd5e1; padding: 16px;">DURUM</th>
                    <th style="color: #cbd5e1; padding: 16px;">OTURAN SAKİN (E-POSTA)</th>
                    <th class="text-end pe-4" style="color: #cbd5e1; padding: 16px;">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color: #64748b;">
                            <i class="fa-solid fa-building fs-2 mb-3 d-block"></i>
                            Bu siteye henüz hiç daire eklenmemiş.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #334155; background-color: transparent;">
                            <td class="fw-bold text-light" style="vertical-align: middle; padding: 16px;">@item.Blok</td>
                            <td style="color: #94a3b8; vertical-align: middle; padding: 16px;">@item.KapiNumarasi</td>
                            <td style="color: #94a3b8; vertical-align: middle; padding: 16px;">@item.Tip</td>
                            <td style="vertical-align: middle; padding: 16px;">
                                @if (item.BosMu || item.Kullanici == null)
                                {
                                    <span class="badge" style="background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid #f59e0b; padding: 6px 12px; border-radius: 6px;">Boş</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid #38bdf8; padding: 6px 12px; border-radius: 6px;">Dolu</span>
                                }
                            </td>
                            <td style="color: #cbd5e1; vertical-align: middle; padding: 16px;">
                                @if (item.BosMu || item.Kullanici == null)
                                {
                                    <span style="color: #64748b; font-style: italic;">- Kimse Oturmuyor -</span>
                                }
                                else
                                {
                                    <span><i class="fa-regular fa-envelope me-2" style="color: #94a3b8;"></i> @item.Kullanici.Eposta</span>
                                }
                            </td>
                            <td class="text-end pe-4" style="vertical-align: middle; padding: 16px;">
                                <a asp-action="Duzenle" asp-route-id="@item.DaireId" class="btn btn-sm fw-bold" style="background-color: transparent; border: 1px solid #38bdf8; color: #38bdf8; border-radius: 8px; padding: 6px 16px; transition: 0.3s;">
                                    Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@model IEnumerable<FlatFlow.Models.Daire>
@{
    ViewData["Title"] = "Daire Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-primary">Daire Listesi</h2>
    <a asp-action="Ekle" class="btn btn-success fw-bold">+ Yeni Daire Ekle</a>
</div>

<div class="card shadow-sm p-3">
    <table class="table table-hover table-bordered mt-2">
        <thead class="table-light">
            <tr>
                <th>Blok</th>
                <th>Kapı No</th>
                <th>Tipi</th>
                <th>Durum</th>
                <th>Oturan Sakin (E-posta)</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Blok</td>
                    <td>@item.KapiNumarasi</td>
                    <td>@item.Tip</td>
                    <td>
                        @if (item.BosMu)
                        {
                            <span class="badge bg-warning text-dark">Boş</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Dolu</span>
                        }
                    </td>
                    <td>@(item.Kullanici != null ? item.Kullanici.Eposta : "-")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary">Düzenle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>